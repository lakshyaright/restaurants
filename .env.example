# TechRescue Digital Menu Configuration
# Supabase project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Anonymous/Public API Key (safe for client side with RLS enabled)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Base application URL used for QR code generation and live menu links
# Default in development: http://localhost:3000
# In production on Cloudflare Pages or custom domain: https://menu.techrescue.in or https://techrescue.in
VITE_APP_URL="http://localhost:3000"
